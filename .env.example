# Local development only. Change the password before using a shared environment.
POSTGRES_DB=agenticiot
POSTGRES_USER=agenticiot
POSTGRES_PASSWORD=agenticiot_local
POSTGRES_PORT=55432
AGENTICIOT_DATABASE_URL=postgresql+psycopg://agenticiot:agenticiot_local@127.0.0.1:55432/agenticiot
# Default deny. Configure your own local-only API credential; see docs/development.md.
AGENTICIOT_API_CLIENTS=[]
AGENTICIOT_TRUSTED_ISSUERS=[]
# Optional metadata deduplication: set a stable random key >=32 characters before using keys.
# AGENTICIOT_INFERENCE_HMAC_KEY=
# 127.0.0.1 bindings in Compose intentionally limit this foundation to local use.
